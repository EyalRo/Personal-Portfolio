---
import BaseLayout from '@layouts/BaseLayout.astro';

const whatIDo = [
  {
    title: 'Security and access',
    description: 'IAM, zero-trust access, audit programs, government compliance. The goal is something that passes review and that people will actually use.',
  },
  {
    title: 'Governance and guardrails',
    description: 'Policy that engineering can implement and an auditor can verify. Clear data boundaries, logging, and approval paths.',
  },
  {
    title: 'Observability',
    description: 'I lead observability for Enterprise Integration Services at Puget Sound Energy. The aim is to measure whether a service is doing its job for the person using it, not just whether it returns a 200.',
  },
  {
    title: 'Architecture',
    description: 'Distributed, event-driven, cloud-native systems. I bridge what engineering can build and what the product needs.',
  },
  {
    title: 'Working across teams',
    description: 'Engineering, security, legal, UX, and executives each need something different. I handle the coordination so the work gets finished.',
  },
  {
    title: 'Adopting AI tools safely',
    description: 'Connecting AI tools to employee systems with proper identity, data boundaries, logging, and a way for a person to step in. Fundamentals first, because the tools are still changing.',
  },
];

const technicalDepth = [
  {
    category: 'Cloud',
    items: 'AWS (Serverless, Lambda, EventBridge, CloudWatch), OCI, Azure',
  },
  {
    category: 'IaC',
    items: 'Terraform',
  },
  {
    category: 'Development',
    items: 'React.js, Node.js, Python, Go, Docker, CI/CD',
  },
  {
    category: 'Data',
    items: 'Oracle Datalake, Data Warehouse',
  },
];
---

<BaseLayout title="Approach" description="How Eyal Rotbart approaches security, operations, and enterprise product work.">
  <section class="container-prose py-20">
    <h1 class="heading-xl mb-3">Approach</h1>
    <span class="accent-bar bg-amber-700 dark:bg-amber-400"></span>

    <!-- Background -->
    <div class="mb-16">
      <h2 class="heading-md mb-6">Background</h2>
      <div class="space-y-4 text-body">
        <p>
          I've spent 15 years as the product person who sits between architecture, security, and the business. At Oracle I owned cloud security products, including the compliance work that got OCI through US government audits. At Puget Sound Energy I run observability for <strong class="text-slate-800 dark:text-slate-200">Enterprise Integration Services (EIS)</strong>, the layer that connects SAP, distribution management systems, AWS backends, and a long list of SaaS and internal apps. Before that I did consulting work across healthcare, e-commerce, and media.
        </p>
        <p>
          I write the specs, I draw the architecture, and I've shipped the code when it needed shipping.
        </p>
      </div>
    </div>

    <!-- Where AI fits -->
    <div class="mb-16">
      <h2 class="heading-md mb-6">Where AI fits</h2>
      <div class="space-y-4 text-body">
        <p>
          AI is the newest thing I work with, not the thing I'm an expert in. Nobody is yet. What carries over from the older work is the same set of questions: who can use it, what data it can see, what happens when it's wrong, who finds out, and how it connects to the systems employees already use. I've been through that with cloud access, with integrations, and with monitoring. I'm applying it to AI tools now.
        </p>
      </div>
    </div>

    <!-- What I Do -->
    <div class="mb-16">
      <h2 class="heading-md mb-8">What I Do</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {whatIDo.map((item) => (
          <div class="card">
            <h3 class="heading-sm mb-2">{item.title}</h3>
            <p class="text-body text-sm">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Technical Depth -->
    <div class="mb-16">
      <h2 class="heading-md mb-8">Technical Depth</h2>
      <div class="space-y-0">
        {technicalDepth.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-start gap-2 py-4 border-t border-slate-200 dark:border-slate-800">
            <span class="font-display font-semibold text-slate-800 dark:text-slate-200 min-w-[120px]">{item.category}</span>
            <span class="text-body text-sm">{item.items}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-12 text-center">
      <h3 class="heading-md mb-4">If this matches a problem you have, get in touch.</h3>
      <a href="/contact/" class="btn-primary">Get in Touch</a>
    </div>
  </section>
</BaseLayout>
