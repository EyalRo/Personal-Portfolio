---
import BaseLayout from '@layouts/BaseLayout.astro';
import PillarCard from '@components/PillarCard.astro';
import WorkCard from '@components/WorkCard.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const featuredWork = allWork.filter((entry) => entry.data.featured).sort((a, b) => a.data.order - b.data.order);

const pillars = [
  {
    title: 'Start with the workflow',
    description: 'I begin with what people are trying to get done and which systems that touches. The tooling comes after.',
  },
  {
    title: 'Know what is happening in production',
    description: 'If you can\'t see a system working, you can\'t tell whether it is working. I build the monitoring in with the product, not after it.',
  },
  {
    title: 'Security is part of the spec',
    description: 'Identity, access, privacy, and audit logs go in the first requirements doc. Retrofitting them is slower and worse.',
  },
  {
    title: 'Make it understood by everyone involved',
    description: 'Most failed rollouts I have seen were misunderstandings between teams, not technical failures. I spend a lot of time on that gap.',
  },
];
---

<BaseLayout title="Eyal Rotbart - Principal Technical Product Manager">
  <!-- Hero -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-30 dark:opacity-20"></div>

    <div class="container-wide relative">
      <div class="flex flex-col md:flex-row items-start gap-12 md:gap-16">
        <div class="flex-1">
          <h1 class="font-display text-5xl md:text-7xl font-bold tracking-tight">
            Eyal Rotbart
          </h1>
          <span class="accent-bar bg-amber-700 dark:bg-amber-400"></span>
          <p class="font-display text-xl md:text-2xl font-medium text-slate-700 dark:text-slate-300 mb-4">
            Principal Technical Product Manager
          </p>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl mb-6">
            I'm a product manager for enterprise platforms: security, observability, and integration. Lately that includes getting AI tools into a company in a way that's controlled, logged, and connected to the systems people already use.
          </p>
          <p class="text-sm text-slate-400 dark:text-slate-500 mb-8 flex items-center gap-3 flex-wrap">
            <span>15+ years in product</span>
            <span class="text-slate-300 dark:text-slate-700">&middot;</span>
            <span>Security</span>
            <span class="text-slate-300 dark:text-slate-700">&middot;</span>
            <span>Observability</span>
            <span class="text-slate-300 dark:text-slate-700">&middot;</span>
            <span>Enterprise integration</span>
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/work/" class="btn-primary">View My Work</a>
            <a href="/contact/" class="btn-secondary">Get in Touch</a>
          </div>
        </div>

        <div class="flex-shrink-0 order-first md:order-last">
          <div class="w-44 h-44 md:w-56 md:h-56 rounded-2xl overflow-hidden shadow-lg">
            <img
              src="/assets/ProfilePic.jpeg"
              alt="Eyal Rotbart"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A note on AI -->
  <section class="container-prose py-12">
    <h2 class="heading-lg mb-4">A note on AI</h2>
    <p class="text-body">
      I don't call myself an AI expert, and I'd be wary of anyone who does. These tools have been in people's hands for a few years at most. What I do bring is the unglamorous side that decides whether any of it survives contact with a real company: identity and access, audit trails, guardrails, monitoring, and integration with the systems employees actually work in.
    </p>
  </section>

  <!-- Pillars -->
  <section class="container-wide py-20">
    <h2 class="heading-lg mb-10">How I work</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0">
      {pillars.map((pillar) => (
        <PillarCard title={pillar.title} description={pillar.description} />
      ))}
    </div>
  </section>

  <!-- Featured Work -->
  <section class="container-wide py-20">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="heading-lg">Selected Work</h2>
      <a href="/work/" class="text-sm font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors">
        View All &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredWork.map((entry) => (
        <WorkCard entry={entry} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-slate-200 dark:border-slate-800">
    <div class="container-wide py-20 text-center">
      <h2 class="heading-lg mb-4">Let's talk</h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-lg mx-auto mb-8 leading-relaxed">
        I'm open to new roles. If you're working out how to adopt AI tools without losing control of your data or your audit trail, I'd like to hear about it.
      </p>
      <a href="/contact/" class="btn-primary">Send a Message</a>
    </div>
  </section>
</BaseLayout>
